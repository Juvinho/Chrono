# =====================================================
# CHRONO Backend Configuration Example
# =====================================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit .env to version control with real credentials!
# =====================================================

# ========== SMTP Email Configuration ==========
# Gmail SMTP settings (required for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# Gmail App Password (for compatibility)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password-here

# ========== Frontend URL ==========
# URL where the frontend is accessible
FRONTEND_URL=http://localhost:5173

# ========== JWT Authentication ==========
# ⚠️  CRITICAL - REQUIRED FOR SERVER TO START
# SECRET KEY FOR SIGNING JWTs
# Requirements:
#   - Minimum 32 characters (ENFORCED)
#   - Must be randomly generated (not a default value like below)
#   - Different for dev vs production
#   - Must NOT be committed to git
#
# Generate a secure key:
#   - Linux/Mac: openssl rand -hex 32 (produces 64 char hex string)
#   - Windows PowerShell: [System.Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes((Get-Random -Maximum 999999999999).ToString())) -replace '[^a-zA-Z0-9]'
#   - Node.js: npm -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Railway Deployment:
#   1. Generate secure secret: openssl rand -hex 32
#   2. Copy the output (will be 64 character hex string)
#   3. Go to Railway: Service → Variables
#   4. Add: Key=JWT_SECRET, Value=<paste-the-64-char-hex-string>
#   5. Redeploy service
#
# Local Development: 
#   - For local testing only, use a 32+ char random string
#   - Never use "your-super-secret-jwt-key-change-this-in-production-12345" in production!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345

# ========== Admin JWT Configuration (Optional) ==========
# ⚠️  OPTIONAL - Only needed if admin panel is used
# Separate JWT secret for admin sessions (different from regular JWT)
# Same requirements as JWT_SECRET: minimum 32 characters, randomly generated
# If not set, admin panel will be disabled with warning
ADMIN_JWT_SECRET=AdminSessionSecret_XYZ123!@#$

# ========== Server Configuration ==========
HOST=0.0.0.0
PORT=3001

# ========== CORS Configuration ==========
# Comma-separated list of allowed origins
# Example: http://localhost:5173,http://10.0.1.118:3000,http://10.0.1.118:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ========== Database Configuration (if needed) ==========
# DATABASE_URL=postgres://user:password@localhost:5432/chrono

# ========== Admin Panel Configuration ==========
# Master password for admin panel access
# CHANGE THIS IN PRODUCTION!
ADMIN_MASTER_PASSWORD=AdminMaster2026!@#$secure
ADMIN_SESSION_DURATION=24

# ========== hCaptcha Configuration (C-08) ==========
# Secret key for hCaptcha verification
# Get from: https://dashboard.hcaptcha.com
HCAPTCHA_SECRET=your-hcaptcha-secret-key-here

# ========== Gemini API Configuration (Backend Only) ==========
# IMPORTANT: Never expose this key to frontend!
# The frontend MUST call backend endpoints for AI features
GEMINI_API_KEY=your-gemini-api-key-here

# ========== Optional: Node Environment ==========
# Development: shows debug logs, less strict validation
# Production: optimized, stricter validation, minimal logs
NODE_ENV=development

# ========== Optional: Application Settings ==========
# Auto-refresh interval for frontend (in minutes)
AUTO_REFRESH_INTERVAL=5

# =====================================================
# SECURITY BEST PRACTICES:
# =====================================================
# 1. Never commit this file with real values
# 2. Each environment (dev, staging, prod) should have its own .env
# 3. Use strong, random passwords for JWT_SECRET (min 32 chars)
# 4. Rotate credentials regularly
# 5. Use different credentials for dev vs production
# 6. In production, use a secrets manager (e.g., AWS Secrets Manager, HashiCorp Vault)
# =====================================================
