{
  "name": "chrono-backend",
  "version": "1.0.0",
  "description": "Backend API for Chrono social network",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node copy-assets.js",
    "build:full": "cd .. && npm install && npm run build",
    "start": "node dist/index.js",
    "db:migrate": "tsx --import dotenv/config src/db/migrate.ts",
    "db:migrate-data": "tsx --import dotenv/config src/scripts/migrate-data.ts",
    "db:sync-follows": "tsx --import dotenv/config src/sync_follows.ts",
    "db:seed": "tsx --import dotenv/config src/db/seed.ts",
    "db:clear": "tsx --import dotenv/config src/db/clear.ts",
    "db:backup": "tsx --import dotenv/config src/scripts/backup.ts",
    "db:fix-encrypted": "tsx --import dotenv/config src/scripts/fix_encrypted_schema.ts",
    "update-user-tags": "tsx --import dotenv/config src/scripts/updateAllUserBios.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "emoji-regex": "^10.6.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.5",
    "otplib": "^13.3.0",
    "pg": "^8.18.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.10.9",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.7.0",
    "typescript": "~5.8.2"
  }
}
