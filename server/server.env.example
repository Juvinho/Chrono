# ========== EMAIL CONFIG ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Frontend URL (used in emails/CORS)
FRONTEND_URL=http://localhost:5173

# ========== AUTH CONFIG ==========
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_random_64_byte_hex_string

# ========== SERVER CONFIG ==========
HOST=0.0.0.0
PORT=3001

# ========== CORS CONFIG ==========
# Comma-separated list of allowed origins (REQUIRED in production)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ========== ADMIN PANEL CONFIG ==========
# Strong master password (REQUIRED - min 16 chars, mixed case + symbols)
ADMIN_MASTER_PASSWORD=CHANGE_ME_strong_password_here

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_JWT_SECRET=CHANGE_ME_generate_a_random_64_byte_hex_string

# Admin session duration in hours
ADMIN_SESSION_DURATION=24

# Primary admin user ID
ADMIN_USER_ID=1

# ========== HCAPTCHA ==========
HCAPTCHA_SECRET=your-hcaptcha-secret-key

# ========== DATABASE ==========
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to 'false' only if your DB provider uses self-signed certs (e.g. Railway)
DB_SSL_REJECT_UNAUTHORIZED=true
