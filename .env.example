# =====================================================
# CHRONO Frontend Environment Variables
# =====================================================
# IMPORTANT: Copy this file to .env.local and fill in your actual values
# .env.local is included in .gitignore for security
# =====================================================

# ========== Frontend API Configuration ==========
# URL where the backend API is accessible
VITE_API_URL=http://localhost:3001/api

# ========== hCaptcha Configuration (C-08) ==========
# Site key for hCaptcha widget 
# Get from: https://dashboard.hcaptcha.com
VITE_HCAPTCHA_SITEKEY=your-hcaptcha-sitekey-here

# ========== Development Mode (optional) ==========
# Set to 'true' to enable verbose logging in development
# VITE_DEBUG=false
