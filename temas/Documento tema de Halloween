# 🎃 HALLOWEEN THEME TOGGLE + AUTO-COMMIT
# ============================================
# Uso:
#   ./scripts/theme-toggle.sh enable    → Ativa tema Halloween
#   ./scripts/theme-toggle.sh disable   → Desativa tema Halloween
#   ./scripts/theme-toggle.sh status    → Verifica status atual
#   ./scripts/theme-toggle.sh schedule  → Agenda ativação automática (Out-Nov)
# ============================================

set -e

# === CONFIGURAÇÕES ===
THEME_NAME="halloween-aero"
BRANCH="main"
CONFIG_FILE="src/config/theme.json"              # Ajuste para seu projeto
CSS_IMPORT_FILE="src/styles/main.css"            # Ajuste para seu projeto
JS_ENTRY_FILE="src/main.js"                      # Ajuste para seu projeto
LAYOUT_FILE="src/index.html"                     # Ou App.jsx / layout.tsx
COMMIT_PREFIX="🎃 [theme]"

# Cores para output
RED='\033[0;31m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
PURPLE='\033[0;35m'
NC='\033[0m' # No Color

# === FUNÇÕES ===

print_banner() {
  echo ""
  echo -e "${ORANGE}╔══════════════════════════════════════════╗${NC}"
  echo -e "${ORANGE}║     🎃  HALLOWEEN AERO THEME TOGGLE  🎃  ║${NC}"
  echo -e "${ORANGE}╚══════════════════════════════════════════╝${NC}"
  echo ""
}

check_git() {
  if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    echo -e "${RED}❌ Erro: Não está em um repositório Git!${NC}"
    exit 1
  fi
}

enable_theme() {
  echo -e "${ORANGE}🦇 Ativando tema Halloween...${NC}"
  echo ""

  # 1. Atualizar config do tema
  if [ -f "$CONFIG_FILE" ]; then
    # Se usa JSON config
    python3 -c "
import json
with open('$CONFIG_FILE', 'r') as f:
    config = json.load(f)
config['active_theme'] = '$THEME_NAME'
config['theme_class'] = 'theme-halloween'
with open('$CONFIG_FILE', 'w') as f:
    json.dump(config, f, indent=2)
print('  ✅ Config atualizado: $CONFIG_FILE')
" 2>/dev/null || {
      # Fallback: criar config
      mkdir -p "$(dirname "$CONFIG_FILE")"
      echo "{\"active_theme\": \"$THEME_NAME\", \"theme_class\": \"theme-halloween\"}" > "$CONFIG_FILE"
      echo -e "  ${GREEN}✅ Config criado: $CONFIG_FILE${NC}"
    }
  fi

  # 2. Adicionar imports CSS
  if [ -f "$CSS_IMPORT_FILE" ]; then
    if ! grep -q "halloween-theme.css" "$CSS_IMPORT_FILE"; then
      echo "" >> "$CSS_IMPORT_FILE"
      echo "/* 🎃 Halloween Theme */" >> "$CSS_IMPORT_FILE"
      echo "@import '../themes/halloween/halloween-theme.css';" >> "$CSS_IMPORT_FILE"
      echo "@import '../themes/halloween/halloween-animations.css';" >> "$CSS_IMPORT_FILE"
      echo -e "  ${GREEN}✅ CSS imports adicionados${NC}"
    else
      echo -e "  ${PURPLE}ℹ️  CSS imports já existem${NC}"
    fi
  fi

  # 3. Adicionar body class no HTML/JSX
  if [ -f "$LAYOUT_FILE" ]; then
    # HTML
    if grep -q '<body' "$LAYOUT_FILE" && ! grep -q 'theme-halloween' "$LAYOUT_FILE"; then
      sed -i 's/<body/<body class="theme-halloween"/' "$LAYOUT_FILE"
      echo -e "  ${GREEN}✅ Classe adicionada ao <body>${NC}"
    fi
    # JSX/TSX (className no body ou div root)
    if grep -q 'className=' "$LAYOUT_FILE" && ! grep -q 'theme-halloween' "$LAYOUT_FILE"; then
      sed -i 's/className="\([^"]*\)"/className="\1 theme-halloween"/' "$LAYOUT_FILE"
      echo -e "  ${GREEN}✅ Classe adicionada ao root element${NC}"
    fi
  fi

  # 4. Adicionar script injector
  if [ -f "$JS_ENTRY_FILE" ]; then
    if ! grep -q "halloween-injector" "$JS_ENTRY_FILE"; then
      echo "" >> "$JS_ENTRY_FILE"
      echo "// 🎃 Halloween Theme Injector" >> "$JS_ENTRY_FILE"
      echo "import './themes/halloween/halloween-injector.js';" >> "$JS_ENTRY_FILE"
      echo -e "  ${GREEN}✅ JS injector importado${NC}"
    fi
  fi

  echo ""
  echo -e "${GREEN}✅ Tema Halloween ATIVADO com sucesso!${NC}"
}

disable_theme() {
  echo -e "${ORANGE}💤 Desativando tema Halloween...${NC}"
  echo ""

  # 1. Remover do config
  if [ -f "$CONFIG_FILE" ]; then
    python3 -c "
import json
with open('$CONFIG_FILE', 'r') as f:
    config = json.load(f)
config['active_theme'] = 'default'
config['theme_class'] = ''
with open('$CONFIG_FILE', 'w') as f:
    json.dump(config, f, indent=2)
print('  ✅ Config revertido')
" 2>/dev/null
  fi

  # 2. Remover CSS imports
  if [ -f "$CSS_IMPORT_FILE" ]; then
    sed -i '/halloween-theme.css/d' "$CSS_IMPORT_FILE"
    sed -i '/halloween-animations.css/d' "$CSS_IMPORT_FILE"
    sed -i '/🎃 Halloween Theme/d' "$CSS_IMPORT_FILE"
    echo -e "  ${GREEN}✅ CSS imports removidos${NC}"
  fi

  # 3. Remover body class
  if [ -f "$LAYOUT_FILE" ]; then
    sed -i 's/ *theme-halloween//g' "$LAYOUT_FILE"
    sed -i 's/class="theme-halloween"//g' "$LAYOUT_FILE"
    sed -i 's/class=" "/class=""/g' "$LAYOUT_FILE"
    echo -e "  ${GREEN}✅ Classe removida do <body>${NC}"
  fi

  # 4. Remover JS injector
  if [ -f "$JS_ENTRY_FILE" ]; then
    sed -i '/halloween-injector/d' "$JS_ENTRY_FILE"
    sed -i '/🎃 Halloween Theme Injector/d' "$JS_ENTRY_FILE"
    echo -e "  ${GREEN}✅ JS injector removido${NC}"
  fi

  echo ""
  echo -e "${GREEN}✅ Tema Halloween DESATIVADO!${NC}"
}

check_status() {
  echo -e "${ORANGE}📊 Status do tema:${NC}"
  echo ""

  if [ -f "$CONFIG_FILE" ] && grep -q "$THEME_NAME" "$CONFIG_FILE"; then
    echo -e "  Estado: ${GREEN}🎃 ATIVO${NC}"
  else
    echo -e "  Estado: ${PURPLE}💤 INATIVO${NC}"
  fi

  # Verificar se arquivos do tema existem
  if [ -d "themes/halloween" ]; then
    echo -e "  Arquivos: ${GREEN}✅ Presentes${NC}"
    echo -e "  Pasta: themes/halloween/"
    ls -la themes/halloween/ 2>/dev/null | tail -n +2 | while read line; do
      echo "    $line"
    done
  else
    echo -e "  Arquivos: ${RED}❌ Não encontrados${NC}"
  fi
}

auto_commit() {
  local action="$1"

  echo ""
  echo -e "${ORANGE}📦 Fazendo auto-commit...${NC}"

  git add -A

  # Verificar se há mudanças
  if git diff --cached --quiet; then
    echo -e "  ${PURPLE}ℹ️  Nenhuma mudança para commitar${NC}"
    return
  fi

  local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
  local commit_msg=""

  case "$action" in
    "enable")
      commit_msg="$COMMIT_PREFIX Ativar tema Halloween Aero [$timestamp]"
      ;;
    "disable")
      commit_msg="$COMMIT_PREFIX Desativar tema Halloween [$timestamp]"
      ;;
    *)
      commit_msg="$COMMIT_PREFIX Atualização de tema [$timestamp]"
      ;;
  esac

  git commit -m "$commit_msg"
  echo -e "  ${GREEN}✅ Commit: $commit_msg${NC}"

  # Push automático
  echo -e "${ORANGE}🚀 Fazendo push para origin/$BRANCH...${NC}"
  git push origin "$BRANCH"
  echo -e "  ${GREEN}✅ Push realizado com sucesso!${NC}"
}

setup_schedule() {
  echo -e "${ORANGE}📅 Configurando agendamento automático...${NC}"
  echo ""

  # Criar cron jobs para ativação/desativação automática
  SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

  # Remover crons anteriores
  crontab -l 2>/dev/null | grep -v "theme-toggle" > /tmp/crontab_temp || true

  # Adicionar novos crons
  # Ativar dia 1 de Outubro às 00:01
  echo "1 0 1 10 * $SCRIPT_PATH enable # 🎃 theme-toggle: ativar halloween" >> /tmp/crontab_temp
  # Desativar dia 5 de Novembro às 00:01
  echo "1 0 5 11 * $SCRIPT_PATH disable # 🎃 theme-toggle: desativar halloween" >> /tmp/crontab_temp

  crontab /tmp/crontab_temp
  rm /tmp/crontab_temp

  echo -e "  ${GREEN}✅ Agendamento configurado:${NC}"
  echo -e "    🎃 Ativar:    1 de Outubro 00:01"
  echo -e "    💤 Desativar:  5 de Novembro 00:01"
  echo ""
  echo -e "  Crons atuais:"
  crontab -l | grep "theme-toggle"
}

# === EXECUÇÃO PRINCIPAL ===

print_banner
check_git

case "${1:-}" in
  enable|on|activate|ativar)
    enable_theme
    auto_commit "enable"
    ;;
  disable|off|deactivate|desativar)
    disable_theme
    auto_commit "disable"
    ;;
  status|check|verificar)
    check_status
    ;;
  schedule|agendar|cron)
    setup_schedule
    ;;
  *)
    echo -e "Uso: $0 {enable|disable|status|schedule}"
    echo ""
    echo "  enable    → Ativa tema Halloween + commit + push"
    echo "  disable   → Desativa tema + commit + push"
    echo "  status    → Verifica se o tema está ativo"
    echo "  schedule  → Agenda ativação automática (Out-Nov)"
    echo ""
    exit 1
    ;;
esac

echo ""
echo -e "${ORANGE}🎃 Feito! Happy Halloween! 🦇${NC}"
```

