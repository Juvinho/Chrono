## 🖥️ Script de Injeção JS: halloween-injector.js

```javascript
/**
 * 🎃 Halloween Theme Injector
 * Injeta elementos decorativos no DOM
 */

(function injectHalloweenElements() {
  // Verificar se tema está ativo
  if (!document.body.classList.contains('theme-halloween')) return;

  // === Injetar Morcegos ===
  const batPositions = [
    { top: '5%', left: '15%', size: '60px' },
    { top: '8%', right: '20%', size: '45px' },
    { top: '12%', left: '60%', size: '35px' },
    { top: '3%', right: '10%', size: '50px' },
  ];

  batPositions.forEach((pos, i) => {
    const bat = document.createElement('img');
    bat.src = '/themes/halloween/assets/bat-' + ((i % 3) + 1) + '.svg';
    bat.className = 'halloween-bat';
    bat.alt = '';
    bat.style.width = pos.size;
    Object.assign(bat.style, pos);
    document.body.appendChild(bat);
  });

  // === Injetar Abóboras ===
  ['left', 'right'].forEach(side => {
    const pumpkin = document.createElement('img');
    pumpkin.src = `/themes/halloween/assets/pumpkin-${side}.webp`;
    pumpkin.className = `halloween-pumpkin ${side}`;
    pumpkin.alt = '';
    document.body.appendChild(pumpkin);
  });

  // === Injetar Neblina ===
  const fog1 = document.createElement('div');
  fog1.className = 'halloween-fog';
  document.body.appendChild(fog1);

  const fog2 = document.createElement('div');
  fog2.className = 'halloween-fog-2';
  document.body.appendChild(fog2);

  // === Injetar Teias ===
  ['top-left', 'top-right'].forEach(pos => {
    const web = document.createElement('img');
    web.src = '/themes/halloween/assets/cobweb-corner.svg';
    web.className = `halloween-cobweb ${pos}`;
    web.alt = '';
    document.body.appendChild(web);
  });

  // === Injetar Partículas (opcional) ===
  for (let i = 0; i < 15; i++) {
    const particle = document.createElement('div');
    particle.className = 'halloween-particle';
    particle.style.left = Math.random() * 100 + '%';
    particle.style.animationDelay = Math.random() * 10 + 's';
    particle.style.animationDuration = (8 + Math.random() * 8) + 's';
    document.body.appendChild(particle);
  }

  console.log('🎃 Halloween theme elements injected!');
})();
