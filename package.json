{
  "name": "chrono:-temporal-social-network",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && echo 'Frontend built' && tsc -p server/tsconfig.json && echo 'Backend built' && node server/dist/scripts/copy-sql-files.js && echo 'SQL files copied'",
    "start": "node server/dist/index.js",
    "db:migrate": "node server/dist/db/migrate.js",
    "db:migrate-data": "tsx server/src/scripts/migrate-data.ts",
    "db:migrate:orchestrate": "tsx server/src/scripts/migrate-orchestrator.ts",
    "db:seed": "node server/dist/db/seed.js",
    "preview": "vite preview",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\"",
    "db:start": "docker-compose up -d postgres",
    "db:stop": "docker-compose down",
    "test": "vitest run",
    "install:all": "npm install && cd server && npm install"
  },
  "dependencies": {
    "@google/genai": "^1.25.0",
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.0.0",
    "emoji-regex": "^10.6.0",
    "lz-string": "^1.5.0",
    "pg": "^8.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "react-window": "^1.8.11",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "concurrently": "^8.2.2",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.7.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}
